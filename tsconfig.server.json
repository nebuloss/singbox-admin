{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-server",
    // rootDir is the server source folder, not the repo, so the build keeps landing
    // on dist-server/server.js — the path the service units and scripts expect.
    "rootDir": "src/server",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/server"
  ]
}
